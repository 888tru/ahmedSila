# Скопировать в .env: cp .env.example .env
# Обязательные переменные без дефолтов — приложение падает на старте, если они не заданы.

# --- HTTP ---
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
# Список origin'ов фронтенда через запятую. Wildcard запрещён.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
DATABASE_URL=postgres://superadmin:superadmin@localhost:5432/superadmin?sslmode=disable
DATABASE_MAX_CONNS=10

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT (Ed25519) ---
# Ключи генерируются командой `task gen-keys` и печатаются в base64.
# В продакшене приходят из secrets manager, не из файла.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=dev-1
JWT_ISSUER=superadmin
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Окружение ---
# dev | staging | prod. В prod cookie выставляются с Secure, логи — в JSON.
APP_ENV=dev
LOG_LEVEL=debug
